{
    "manifest_version": 3,

    "name": "PRE-GUARD AI",

    "version": "0.8.0",

    "description": "AI-powered pre-navigation web security.",

    "permissions": [
        "storage"
    ],

    "host_permissions": [
        "http://127.0.0.1:8000/*",
        "http://localhost:8000/*"
    ],

    "background": {
        "service_worker": "background.js"
    },

    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],

    "action": {
        "default_popup": "popup.html"
    }
}